# ktlint reads this; it makes the formatting contract explicit instead of relying on defaults,
# and keeps IDEs from re-wrapping what ktlint accepts.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_size = 4
max_line_length = 140

[*.{yml,yaml,json}]
indent_size = 2
